# Copy to .env and set your own API key. Exported environment variables take priority.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=replace-with-your-key

# Single-round selection: v1 baseline, v2 enables context budgets (Phase 5).
# Unknown/unregistered keys fall back to v1.
# LOOP_IMPL=v1

# Phase 10 Part 1: candidate-only precompression (no reuse yet).
# Default 1 = disabled until the later reuse/quality gates are complete.
# Explicit experiments: LOOP_IMPL=v2 and MINICOCO_PRECOMPACT_RATIO=0.60.
# Workers: 2 per process, 1 per session, 60s timeout, 1 attempt/30s/session.
# MINICOCO_PRECOMPACT_RATIO=1

# Session storage. Relative paths resolve from backend process cwd;
# run_backend.sh uses backend/data by default. File profile: one writer per directory.
# MINICOCO_DATA_DIR=/absolute/path/to/minicoco-data
# STORE_BACKEND=file

# Optional real database profile: Go >= 1.26, bash run_backend_realdb.sh.
# No automatic migration from file stores. SQLite lives in MINICOCO_DATA_DIR/meta.sqlite.
# STORE_BACKEND=real
# MONGO_URI=mongodb://127.0.0.1:27017
# MONGO_DATABASE=minicoco
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PREFIX=minicoco:

# Embedded routes: deepseek-flash, deepseek-v4-pro, mock, mock-claude, mock-xml.
# Optional complete replacement table for custom models (not a merge; limit 1 MiB).
# MINICOCO_MODELS_FILE=/absolute/path/models.json
# To use each route baseURL, export LLM_BASE_URL= (overrides this file).
# isFunctionCall is per-route. Remove the retired MINICOCO_MODEL_IS_FUNCTION_CALL.
# LLM_MODEL=mock-xml demonstrates XML results; mock-claude selects a second prompt family.
# Debug logs complete messages to stderr and may contain private content.
# MINICOCO_DEBUG_PROMPT=1

# Optional offline faults (default effective provider must be mock via model or override).
# LLM_MOCK_MODE=flaky
# LLM_MOCK_FLAKY_FAILS=2
